# --- Required (set these in Railway > Variables) ---
SECRET_KEY=123456789123456789123456789123456789123456789123456789
ADMIN_PASSWORD=123456789

# --- Database: on Railway add the PostgreSQL plugin; DATABASE_URL is injected automatically.
# Without it the app uses a local SQLite file (data is LOST on every redeploy on Railway!)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Optional ---
# EITAA_API_BASE=https://eitaayar.ir/api   # change if you route through your own relay
# EITAA_PROXY=http://user:pass@host:port   # outbound proxy for Eitaa calls only
# BOT_TOKEN=...   # normally entered in the web panel instead
# ADMIN_IDS=...   # normally entered in the web panel instead

# --- AI agent (or set the key from the web panel)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROXY=http://user:pass@host:port        # outbound proxy for AI calls only
# EITAA_WEB_BASE=https://eitaa.com           # reading public channels; point to your own relay if blocked
